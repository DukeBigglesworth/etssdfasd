    if not S or not S.FLASK_API_URL then return nil end
    local base = tostring(S.FLASK_API_URL):gsub("/$", "")
    local ok, resp = pcall(req, {
        Url = base .. "/eq",
        Method = "GET",
    })
    if ok and type(resp) == "table" and resp.Body then
        local s, d = pcall(function()
            return HttpService:JSONDecode(resp.Body)
        end)
        if s and type(d) == "table" then
            return d
        end
    end

    ok, resp = pcall(req, {
        Url = base .. "/status",
        Method = "GET",
    })
    if ok and type(resp) == "table" and resp.Body then
        local s, d = pcall(function()
            return HttpService:JSONDecode(resp.Body)
        end)
        if s and type(d) == "table" and type(d.eq) == "table" then
            return d.eq
        end
    end
    return nil
end

local function sendQueueToWebhook()
    if not isQueueBot then return end
    local data = getQueue()
    local queueList = data.queue or {}
    local current = data.current
    local currentTitle = data.current_title
    local nextSong = data.next
    if #queueList == 0 and not current then
        sendToWebhook("Music Queue: Empty")
        return
    end
    local queueText = "Music Queue:\n\n"
    if current then
        if currentTitle then
            queueText = queueText .. "Now Playing: " .. tostring(currentTitle) .. "\n"
        else
            queueText = queueText .. "Now Playing: " .. tostring(current) .. "\n"
        end
    else
        queueText = queueText .. "Now Playing: Nothing\n"
    end
    if nextSong then
        queueText = queueText .. "Next: " .. tostring(nextSong) .. "\n"
    end
    if #queueList > 1 then
        queueText = queueText .. "\nUp Next (" .. (#queueList - 1) .. "):\n"
        for i = 2, math.min(#queueList, 6) do
            queueText = queueText .. tostring(i - 1) .. ". " .. tostring(queueList[i]) .. "\n"
        end
        if #queueList > 6 then
            queueText = queueText .. "... and " .. (#queueList - 6) .. " more\n"
        end
    end
    sendToWebhook(queueText)
end

