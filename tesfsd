local function worldOrbitLoop(p, getOffset)
    local root = GetRoot(p)
    if not root then return end
    StopAll()
    SetNoclip(true)
    local spin = 0
    local lastT = tick()
    pcall(function()
        local hum = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.AutoRotate = false
            hum.PlatformStand = true
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
        end
    end)
    ActiveLoops.orbit = RunService.Heartbeat:Connect(function()
        if not p or not p.Parent then return end
        root = GetRoot(p)
        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not myRoot then return end
        local now = tick()
        local dt = math.clamp(now - lastT, 0, 0.05)
        lastT = now
        local idx, total = GetAltIndex()
        total = math.max(total, 1)
        local cf, newSpin = getOffset(idx, total, root, spin, dt)
        spin = newSpin
        if typeof(cf) == "CFrame" then
            myRoot.CFrame = cf
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function cmd_orbit(name, rad)
