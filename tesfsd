local function cmd_npc()
    StopAll()
    NpcMode = true
    local hum = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
    if hum then
        hum.WalkSpeed = 10
        hum.JumpPower = 30
        hum.PlatformStand = false
        hum.AutoRotate = true
    end
    local nextChat = tick() + math.random(2, 5)
    local nextWalk = tick() + 0.5
    local conn = RunService.Heartbeat:Connect(function()
        if not NpcMode then return end
        local root = GetRoot(LP)
        hum = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
        if not root or not hum or not hum.Parent then return end
        if tick() > nextWalk then
            nextWalk = tick() + math.random(2, 6)
            hum:MoveTo(root.Position + Vector3.new(math.random(-25, 25), 0, math.random(-25, 25)))
