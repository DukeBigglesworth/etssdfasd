local function Say(msg)
    if not msg then return end
    pcall(function()
        local r = ReplicatedStorage:FindFirstChild("SayMessageRequest", true)
        if r then
            r:FireServer(tostring(msg), "All")
            return
        end
        local g = TextChatService:FindFirstChild("RBXGeneral", true)
        if g then
            g:SendAsync(tostring(msg))
        end
    end)
end

local function Whisper(plr, msg)
    if not plr or not msg then return end
    local name = plr.Name

    pcall(function()
        local r = ReplicatedStorage:FindFirstChild("SayMessageRequest", true)
        if r then
            r:FireServer("/w " .. name .. " " .. tostring(msg), "All")
            return
        end
    end)
    pcall(function()
        local g = TextChatService:FindFirstChild("RBXGeneral", true)
        if g then
            g:SendAsync("/w " .. name .. " " .. tostring(msg))
            return
        end
    end)
    pcall(function()

        local channels = TextChatService:FindFirstChild("TextChannels")
        if channels then
            local w = channels:FindFirstChild("RBXWhisper:" .. name)
                or channels:FindFirstChild("RBXWhisper")
            if w and w.SendAsync then
                w:SendAsync(tostring(msg))
            end
        end
    end)
end


