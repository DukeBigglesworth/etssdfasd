local function sendToWebhook(msg)
    if not isQueueBot then return end
    local data = { content = msg, username = "Music Bot" }
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        pcall(function()
            req({
                Url = S.WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(data),
            })
        end)
    end
end

local function sendToFlask(endpoint, data)
    if not isQueueBot then return nil end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return nil end
    local opts = {
        Url = S.FLASK_API_URL .. endpoint,
        Method = data and "POST" or "GET",
        Headers = { ["Content-Type"] = "application/json" },
    }
    if data then opts.Body = HttpService:JSONEncode(data) end
    local ok, resp = pcall(req, opts)
    if ok and resp and resp.Body then
        local s, d = pcall(HttpService.JSONDecode, HttpService, resp.Body)
        if s then return d end
    end
    return nil
end

local function getQueue()
