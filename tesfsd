    local lastMove = 0
    ActiveLoops.worm = RunService.Heartbeat:Connect(function()
        local myRoot = GetRoot(LP)
        local hum = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
        if not myRoot or not hum or not hum.Parent then return end


        local chain = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if S.altAccounts[plr.Name] and GetRoot(plr) then
                table.insert(chain, plr)
            end
        end
        table.sort(chain, function(a, b)
            return a.Name < b.Name
        end)

        local myIdx = nil
        for i, plr in ipairs(chain) do
            if plr == LP then
                myIdx = i
                break
            end
        end
        if not myIdx then return end


        local followPlr = head
        if myIdx > 1 then
            followPlr = chain[myIdx - 1]
        end

        local targetRoot = GetRoot(followPlr)
        if not targetRoot then
            targetRoot = GetRoot(head)
