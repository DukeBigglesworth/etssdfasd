local function KahootParseBody(body)
    if not body or body == "" then return nil end

    local okJ, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if okJ and type(decoded) == "table" then
        if decoded.questions then return decoded.questions end
        if decoded[1] and type(decoded[1]) == "table" then return decoded end
        return decoded
    end

    local okL, result = pcall(function()
        return loadstring(body)()
    end)
    if okL and type(result) == "table" then return result end
    return nil
end

local function KahootLoadQuestions(gistURL)
    local themes = S.kahootThemes or {}
    if gistURL == "COMBINED" then
        local combined = {}
        for themeName, url in pairs(themes) do
            if themeName ~= "all" and url ~= "COMBINED" then
                local ok, body = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok then
                    local result = KahootParseBody(body)
                    if type(result) == "table" then
                        for _, q in pairs(result) do
                            if type(q) == "table" and q.q then
                                table.insert(combined, q)
                            end
                        end
                    end
                end
            end
        end
        if #combined > 0 then return combined end
        return {{q = "No themes loaded", a = {"Check", "Your", "Gist", "URLs"}, c = 1}}
    end
    local ok, body = pcall(function()
        return game:HttpGet(gistURL)
    end)
    if ok then
        local result = KahootParseBody(body)
        if type(result) == "table" and #result > 0 then return result end
        if type(result) == "table" then
            local arr = {}
            for _, q in pairs(result) do
                if type(q) == "table" and q.q then table.insert(arr, q) end
            end
            if #arr > 0 then return arr end
        end
    end
    return {{q = "Gist Link Missing/Failed", a = {"Check", "The", "Link", "Again"}, c = 1}}
end

