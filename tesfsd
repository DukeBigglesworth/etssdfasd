local function applyRootCF(myRoot, cf, physicsTarget)
    if typeof(cf) ~= "CFrame" then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        myRoot = hrp
    end
    if not myRoot then return end
    myRoot.Anchored = false
    myRoot.CFrame = cf
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    if sethiddenproperty then
        pcall(function()
            sethiddenproperty(myRoot, "NetworkIsSleeping", false)
            local rep = physicsTarget or myRoot
            if typeof(rep) == "Instance" then
                sethiddenproperty(myRoot, "PhysicsRepRootPart", rep)
            else
                sethiddenproperty(myRoot, "PhysicsRepRootPart", myRoot)
            end
        end)
    end
end


