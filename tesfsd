local function WeldTo(targetPart, offsetFunc)
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return nil end

    local saved = {}
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            saved[v] = { CanCollide = v.CanCollide, Massless = v.Massless }
            v.CanCollide = false
            v.Massless = true
        end
    end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        hum.PlatformStand = true
    end)

    pcall(function()
        if setsimulationradius then
            setsimulationradius(1e6, 1e6)
        end
    end)

    local weld = {}
    local conn = RunService.Heartbeat:Connect(function()
        if not char.Parent or not targetPart or not targetPart.Parent then
            weld:Destroy()
            return
        end
        local ok, offset = pcall(offsetFunc)
        if not ok or typeof(offset) ~= "CFrame" then
            offset = CFrame.new()
        end
        pcall(function()
            root.CFrame = targetPart.CFrame * offset
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        pcall(function()
            if sethiddenproperty then
                sethiddenproperty(root, "PhysicsRepRootPart", targetPart)
            end
        end)
        pcall(function()
            if setsimulationradius then
                setsimulationradius(1e6, 1e6)
            end
        end)
    end)

    function weld:Destroy()
        if conn then
            conn:Disconnect()
            conn = nil
        end
        pcall(function()
            if root and root.Parent then
                if sethiddenproperty then
                    sethiddenproperty(root, "PhysicsRepRootPart", root)
                end
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            for part, props in pairs(saved) do
                if part and part.Parent then
                    part.CanCollide = props.CanCollide
                    part.Massless = props.Massless
                end
            end
            if hum and hum.Parent then
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end
    return weld
end

local function TeleportOnce(cf)
