local Authorized = { [S.mainAccount] = true }
local AuthorizedIds = {}
do
    local extra = S.authorizedUsers or S.Authorized or S.whitelist
    if type(extra) == "table" then
        for k, v in pairs(extra) do
            if type(k) == "string" and v == true then
                Authorized[k] = true
            elseif type(v) == "string" then
                Authorized[v] = true
            elseif type(v) == "number" then
                AuthorizedIds[tostring(v)] = true
            end
        end
    end
end

local function isMainName(name)
    if not name then return false end
    return tostring(name):lower() == tostring(S.mainAccount):lower()
end

local function isAuthorized(plr)
    if not plr then return false end
    if isMainName(plr.Name) then return true end
    if AuthorizedIds[tostring(plr.UserId)] == true then return true end
    if Authorized[plr.Name] == true then return true end
    if plr.DisplayName and Authorized[plr.DisplayName] == true then return true end
    local ln = plr.Name:lower()
    local ld = plr.DisplayName and plr.DisplayName:lower() or ""
    for name, ok in pairs(Authorized) do
        if ok and type(name) == "string" then
            local n = name:lower()
            if n == ln or (ld ~= "" and n == ld) then
                return true
            end
        end
    end
    return false
end

local function grantAuth(name, userId)
    if name and name ~= "" then
        Authorized[tostring(name)] = true
    end
    if userId then
        AuthorizedIds[tostring(userId)] = true
    end
end

local function revokeAuth(name, userId)
    if name and not isMainName(name) then
        Authorized[tostring(name)] = nil
    end
    if userId then
        AuthorizedIds[tostring(userId)] = nil
    end
end


