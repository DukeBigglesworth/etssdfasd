function cmd_visualizer(name, spacing)
    local p = ResolveTarget(name)
    if not p then return end
    local root0 = GetRoot(p)
    if not root0 then return end
    StopAll()
    SetNoclip(true)
    spacing = tonumber(spacing) or 3.5
    local maxH = 10
    local lastFetch = 0
    local smooth = {0, 0, 0, 0, 0, 0, 0, 0}
    local display = 0
    local right = root0.CFrame.RightVector
    if right.Magnitude < 0.05 then right = Vector3.new(1, 0, 0) else right = right.Unit end
    local center = root0.Position
    pcall(function()
        local hum = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.AutoRotate = false
            hum.PlatformStand = true
        end
    end)
    ActiveLoops.visualizer = RunService.Heartbeat:Connect(function()
        local root = GetRoot(p)
        local myRoot = GetRoot(LP)
        if not myRoot then return end
        if root then center = root.Position end
        if tick() - lastFetch > 0.1 then
            lastFetch = tick()
            local data = getEq()
            if data and type(data.bands) == "table" then
                for i = 1, 8 do
                    smooth[i] = smooth[i] * 0.55 + (tonumber(data.bands[i]) or 0) * 0.45
                end
            elseif data then
                local b = tonumber(data.bass) or 0
                local m = tonumber(data.mid) or 0
                local tr = tonumber(data.treble) or 0
                smooth[1] = smooth[1] * 0.55 + b * 0.45
                smooth[2] = smooth[2] * 0.55 + b * 0.45
                smooth[4] = smooth[4] * 0.55 + m * 0.45
                smooth[5] = smooth[5] * 0.55 + m * 0.45
                smooth[7] = smooth[7] * 0.55 + tr * 0.45
                smooth[8] = smooth[8] * 0.55 + tr * 0.45
            end
        end
        local idx, total = GetAltIndex()
        total = math.max(total, 1)


        local bandIdx
        if total == 1 then
            bandIdx = 4
        else
            bandIdx = math.clamp(math.floor((idx - 1) / (total - 1) * 7 + 1 + 0.5), 1, 8)
        end
        local level = math.clamp(smooth[bandIdx] or 0, 0, 1)
        level = level * level * 0.35 + level * 0.65
        display = display * 0.5 + level * 0.5
        local height = 0.5 + display * maxH
        local centered = idx - (total + 1) / 2
        if root then
            right = root.CFrame.RightVector
            if right.Magnitude < 0.05 then right = Vector3.new(1, 0, 0) else right = right.Unit end
        end
        local pos = center + right * (centered * spacing) + Vector3.new(0, height, 0)
        local look = (root and root.CFrame.LookVector) or Vector3.new(0, 0, -1)
        local face = CFrame.new(pos, pos + Vector3.new(look.X, 0, look.Z))
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") or myRoot
        applyRootCF(hrp, face, hrp)
    end)
end

