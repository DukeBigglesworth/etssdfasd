    if name and tostring(name) ~= "" and not tonumber(name) then
        p = FindPlayer(name)
    end
    if not p then
        p = Players:FindFirstChild(S.mainAccount)
    end
    if not p or not GetRoot(p) then return end
    if tonumber(rad) then
        MoveSettings.OrbitRadius = tonumber(rad)
    elseif tonumber(name) then
        MoveSettings.OrbitRadius = tonumber(name)
    end
    worldOrbitLoop(p, function(idx, total, root, spin, dt)
        local r = MoveSettings.OrbitRadius or 7
        total = math.max(total, 1)
        idx = math.clamp(idx, 1, total)
        spin = (spin + (MoveSettings.OrbitSpeed or 1.8) * dt) % (math.pi * 2)
        local angle = ((idx - 1) / total) * math.pi * 2 + spin
        local center = root.Position
        local pos = center + Vector3.new(math.cos(angle) * r, MoveSettings.Height or 0, math.sin(angle) * r)
        return CFrame.lookAt(pos, center), spin
    end)
end

