local RecentChatMessages = {}

local function onChatted(player, message)
    if not message or message == "" then return end
    local key = tostring(player.UserId) .. "\0" .. message
    local now = os.clock()
    if RecentChatMessages[key] and now - RecentChatMessages[key] < 0.25 then
        return
    end
    RecentChatMessages[key] = now
    local lower = message:lower()
    local prefix = (S.prefix or "."):lower()


    if message:sub(1, 12) == "SCHWEIN_AUTH" then
        if not isMainName(player.Name) then return end
        local n, id = message:sub(14):match("^(%S+)%s*(%d*)")
        if n then
            grantAuth(n, id ~= "" and tonumber(id) or nil)
        end
        return
    end
    if message:sub(1, 14) == "SCHWEIN_DEAUTH" then
        if not isMainName(player.Name) then return end
        local n, id = message:sub(16):match("^(%S+)%s*(%d*)")
        if n and not isMainName(n) then
            revokeAuth(n, id ~= "" and tonumber(id) or nil)
        end
        return
    end
    if message:sub(1, 11) == "SCHWEIN_MWL" then
        if player.Name ~= S.mainAccount then return end
        local n, id = message:sub(13):match("^(%S+)%s*(%d*)")
        if n then musicListGrant(MusicWhitelist, MusicWhitelistIds, n, id ~= "" and tonumber(id) or nil) end
        return
    end
    if message:sub(1, 13) == "SCHWEIN_UNMWL" then
        if player.Name ~= S.mainAccount then return end
        local n, id = message:sub(15):match("^(%S+)%s*(%d*)")
        if n then musicListRevoke(MusicWhitelist, MusicWhitelistIds, n, id ~= "" and tonumber(id) or nil) end
        return
    end
    if message:sub(1, 11) == "SCHWEIN_MBL" then
        if player.Name ~= S.mainAccount then return end
        local n, id = message:sub(13):match("^(%S+)%s*(%d*)")
        if n then musicListGrant(MusicBlacklist, MusicBlacklistIds, n, id ~= "" and tonumber(id) or nil) end
        return
    end
    if message:sub(1, 13) == "SCHWEIN_UNMBL" then
        if player.Name ~= S.mainAccount then return end
        local n, id = message:sub(15):match("^(%S+)%s*(%d*)")
        if n then musicListRevoke(MusicBlacklist, MusicBlacklistIds, n, id ~= "" and tonumber(id) or nil) end
        return
    end


    if isSetupActive and isQueueBot then
        if lower:sub(1, 6) == "/play " or lower == "/voteskip" or lower == "yes" or lower == "no" then
            if not isPlayerInRange(player) then
                if lower:sub(1, 6) == "/play " then
                    Say(player.Name .. " too far (come within 10 studs)")
                end
                return
            end
            if lower:sub(1, 6) == "/play " then
                if not canSuggestMusic(player) then
                    Say(player.Name .. " cant suggest songs")
                    return
                end
                local q = message:sub(7)
                if q ~= "" then
                    local r = sendToFlask("/play", { query = q })
                    if r and r.status == "queued" then Say("queued " .. q) end
                end
                return
            end
            if lower == "/voteskip" then
                if voteSkipActive or voteSkipUsedForCurrent then return end
                voteSkipActive = true
                currentVotes = { yes = {}, no = {} }
                Say("vote skip 10s yes/no")
                task.delay(10, function()
                    voteSkipActive = false
                    local y, n = 0, 0
                    for _ in pairs(currentVotes.yes) do y = y + 1 end
                    for _ in pairs(currentVotes.no) do n = n + 1 end
                    Say("yes " .. y .. " no " .. n)
                    if y > n then
                        sendToFlask("/skip", {})
                        Say("skipped")
                    else
                        Say("kept")
                    end
                end)
                return
            end
            if voteSkipActive then
                if lower == "yes" then currentVotes.yes[player.UserId] = true
                elseif lower == "no" then currentVotes.no[player.UserId] = true end
                return
            end
        end
    end

    if not isAuthorized(player) then return end

    if isSetupActive and isQueueBot then
        if lower:sub(1, 6) == "/play " then
            if not isPlayerInRange(player) then
                Say(player.Name .. " too far")
                return
            end
            if not canSuggestMusic(player) then
                Say(player.Name .. " cant suggest songs")
                return
            end
            local q = message:sub(7)
            if q ~= "" then
                local r = sendToFlask("/play", { query = q })
                if r and r.status == "queued" then Say("queued " .. q) end
            end
            return
        end
        if lower == "/voteskip" then
            if not isPlayerInRange(player) or voteSkipActive or voteSkipUsedForCurrent then return end
            voteSkipActive = true
            currentVotes = { yes = {}, no = {} }
            Say("vote skip 10s yes/no")
            task.delay(10, function()
                voteSkipActive = false
                local y, n = 0, 0
                for _ in pairs(currentVotes.yes) do y = y + 1 end
                for _ in pairs(currentVotes.no) do n = n + 1 end
                Say("yes " .. y .. " no " .. n)
                if y > n then
                    sendToFlask("/skip", {})
                    Say("skipped")
                else
                    Say("kept")
                end
            end)
            return
        end
        if voteSkipActive then
            if lower == "yes" then currentVotes.yes[player.UserId] = true
            elseif lower == "no" then currentVotes.no[player.UserId] = true end
            return
        end
    end


    if isQueueBot and isAuthorized(player) then
        if lower == "/skip" then sendToFlask("/skip", {}) Say("skipped")
        elseif lower == "/queue" then
            local d = getQueue()
            local q = d.queue or {}
            local msg = ""
            if d.current_title then msg = "now " .. d.current_title
            elseif d.current then msg = "now " .. tostring(d.current) end
            if d.next then msg = msg .. " next " .. tostring(d.next) end
            msg = msg .. " waiting " .. math.max(0, #q - 1)
            Say(msg)
        elseif lower == "/loop" then
            local r = sendToFlask("/loop", {})
            if r then Say("loop " .. (r.loop and "on" or "off")) end
        elseif lower == "/pause" then sendToFlask("/pause", {}) Say("paused")
        elseif lower == "/resume" or lower == "/unpause" then sendToFlask("/resume", {}) Say("resumed")
        elseif lower == "/clearqueue" then sendToFlask("/clearqueue", {}) Say("cleared")
        elseif lower:sub(1, 8) == "/volume " then
            local vol = tonumber(message:sub(9))
            if vol and vol >= 0 and vol <= 100 then
                local r = sendToFlask("/volume", { volume = vol })
                if r then Say("vol " .. r.volume) end
            end
        end
    end

    if lower:sub(1, #prefix) ~= prefix then return end
    local body = message:sub(#prefix + 1)
    local parts = {}
    for w in body:gmatch("%S+") do table.insert(parts, w) end
    if #parts == 0 then return end
    local cmd = parts[1]:lower()
    table.remove(parts, 1)
    local fn = Commands[cmd]
    if fn then
        LastCommander = player
        if isAlt or isMain or isQueueBot or cmd == "adduser" or cmd == "removeuser" or cmd == "mwl" or cmd == "unmwl" or cmd == "mwlclear" or cmd == "mbl" or cmd == "unmbl" or cmd == "credits" or cmd == "totalcmds" or cmd == "info" or cmd == "check" or cmd == "avcb" or cmd == "sync" or cmd == "clone" or cmd == "ksetup" or cmd == "kstart" or cmd == "kstop" or cmd == "kclear" or cmd == "kthemes" or cmd == "kend" then
            pcall(fn, parts)
        end
    end
end

