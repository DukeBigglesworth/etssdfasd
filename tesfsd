    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
    })
    local ok = pcall(function()
        path:ComputeAsync(root.Position, targetRoot.Position)
    end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        local conn = RunService.Heartbeat:Connect(function()
            local tr = GetRoot(p)
            if tr and hum.Parent then
                hum:MoveTo(tr.Position)
            end
        end)
        ActiveLoops["pf"] = conn
        return
    end
    local waypoints = path:GetWaypoints()
    local idx = 1
    local conn = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent or not hum.Parent then return end
        local tr = GetRoot(p)
        if not tr then return end
        if idx > #waypoints then
            hum:MoveTo(tr.Position)
            return
        end
        local wp = waypoints[idx]
        if (root.Position - wp.Position).Magnitude < 4 then
            idx = idx + 1
            if wp.Action == Enum.PathWaypointAction.Jump then
                hum.Jump = true
            end
        else
            hum:MoveTo(wp.Position)
