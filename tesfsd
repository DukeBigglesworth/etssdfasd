local function GetRoot(plr)
    local c = plr and plr.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
        or c.PrimaryPart
        or c:FindFirstChild("Torso")
        or c:FindFirstChild("LowerTorso")
end


