local function FindPlayer(query)
    if not query or query == "" then return nil end
    query = tostring(query):lower()
    local prefixHit, substrHit
    for _, p in ipairs(Players:GetPlayers()) do
        local n, d = p.Name:lower(), p.DisplayName:lower()
        if n == query or d == query then return p end
        if not prefixHit and (n:sub(1, #query) == query or d:sub(1, #query) == query) then
            prefixHit = p
        end
        if not substrHit and (n:find(query, 1, true) or d:find(query, 1, true)) then
            substrHit = p
        end
    end
    return prefixHit or substrHit
end


local LastCommander = nil
local function ResolveTarget(name)
    if name and tostring(name) ~= "" then
        local p = FindPlayer(name)
        if p then return p end
    end
    if LastCommander and LastCommander.Parent then
        return LastCommander
    end
    return Players:FindFirstChild(S.mainAccount)
end

local function GetAltIndex()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if S.altAccounts[plr.Name] and GetRoot(plr) then
            table.insert(list, plr.Name)
        end
    end
    table.sort(list)
    local total = #list
    if total == 0 then return 1, 1 end
    for i, n in ipairs(list) do
        if n == LP.Name then
            return i, total
        end
    end
    return 1, total
end

