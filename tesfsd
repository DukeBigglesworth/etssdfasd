local function cmd_clone(name)
    if not name or name == "" then
        Say("usage: .clone displayname-or-abbreviation")
        return
    end

    local target = FindPlayer(name)
    if not target then
        Say("clone target not found: " .. tostring(name))
        return
    end

    local userId = target.UserId
    local cloneRemote = ReplicatedStorage:FindFirstChild("event_clone_avatar")
    local profileRemote = ReplicatedStorage:FindFirstChild("ProfileAvatarRemote")


    local cloned = false
    if cloneRemote and cloneRemote:IsA("RemoteEvent") then
        cloned = pcall(function()
            cloneRemote:FireServer(userId)
        end)
    end

    if not cloned and profileRemote and profileRemote:IsA("RemoteEvent") then
        cloned = pcall(function()
            profileRemote:FireServer("CopyAvatar", userId)
        end)
    end

    if not cloned then
        Say("clone failed: this game has no supported avatar remote")
    end
end

