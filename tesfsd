local function isMicMuted()
    local muted
    pcall(function()
        local adi = LP:FindFirstChildWhichIsA("AudioDeviceInput", true)
        if adi then
            if adi.Muted == true then muted = true return end
            if adi.Active == false then muted = true return end
            if adi.Muted == false then muted = false return end
        end
    end)
    if type(muted) == "boolean" then return muted end
    pcall(function()
        if voicechatinternal and typeof(voicechatinternal.IsMuted) == "function" then
            muted = voicechatinternal:IsMuted()
        end
    end)
    if type(muted) == "boolean" then return muted end
    return nil
end

local function setmutestate(state)
    local adi = LP:FindFirstChildWhichIsA("AudioDeviceInput", true)
    if adi then
        adi.Active = not state
        return
    end
    pcall(function()
        if voicechatinternal and voicechatinternal.PublishPause then
            voicechatinternal:PublishPause(state)
        end
    end)
end

local function runAVCB(opts)
    opts = type(opts) == "table" and opts or {}
    local forceUnmuteAtEnd = opts.forceUnmuteAtEnd == true
    local ismuted = true
    local hiddenfolder = Instance.new("Folder")
    hiddenfolder.Name = "Schwein_VC_Hidden"
    pcall(function()
        hiddenfolder.Parent = game:GetService("RobloxReplicatedStorage")
    end)

    local topbarapp, unibarleft, unibarmenu, unibarcontainer, micmutebutton
    local clonedicon, originalicon
    pcall(function()
        topbarapp = CoreGui:WaitForChild("TopBarApp", 15)
        topbarapp = topbarapp:WaitForChild("TopBarApp", 15)
    end)
    pcall(function()
        unibarleft = topbarapp:WaitForChild("UnibarLeftFrame", 15)
    end)
    pcall(function()
        unibarmenu = unibarleft:FindFirstChild("UnibarMenu")
            or unibarleft:FindFirstChild("ChromeMenu")
            or unibarleft:WaitForChild("UnibarMenu", 8)
            or unibarleft:WaitForChild("ChromeMenu", 8)
    end)
    pcall(function()
        unibarcontainer = unibarmenu:WaitForChild("2", 15):WaitForChild("3", 15)
    end)
    pcall(function()
        micmutebutton = unibarcontainer and unibarcontainer:FindFirstChild("toggle_mic_mute", true)
    end)

    local function geticonlabel(button)
        button = button or micmutebutton
        local result
        pcall(function()
            result = button:WaitForChild("IntegrationIconFrame", 15)
                :WaitForChild("IntegrationIcon", 15)["1"]
        end)
        return result
    end

    if not micmutebutton then
        pcall(function() voicechatservice:joinVoice() end)
        task.wait(2)
        pcall(function()
            unibarcontainer = unibarmenu:WaitForChild("2", 15):WaitForChild("3", 15)
            micmutebutton = unibarcontainer:WaitForChild("toggle_mic_mute", 15)
        end)
    end

    if not micmutebutton then
        return false, "mic_button_missing"
    end

    task.wait(1)

    pcall(function() voicechatservice:leaveVoice() end)
    task.wait(2)

    pcall(function()
        if not getconnectionsfunc or not voicechatinternal then return end
        local connections = getconnectionsfunc(voicechatinternal.StateChanged)
        for i = 7, #connections do
            if connections[i] then
                pcall(function() connections[i]:Disable() end)
            end
        end
    end)
    task.wait(2)

    local joinDone, joinOk = false, false
    local joinWait = tick()
    task.spawn(function()
        joinOk = pcall(function() voicechatservice:joinVoice() end)
        joinDone = true
    end)
    while not joinDone and tick() - joinWait < 8 do
        task.wait(0.1)
    end
    task.wait(2)

    pcall(function()
        unibarcontainer = unibarmenu:WaitForChild("2", 15):WaitForChild("3", 15)
        micmutebutton = unibarcontainer:WaitForChild("toggle_mic_mute", 15)
    end)

    if micmutebutton and unibarcontainer then
        pcall(function()
            local clonedmutebutton = micmutebutton:Clone()
            micmutebutton.Parent = hiddenfolder
            clonedmutebutton.Name = "toggle_mic_mute_new"
            clonedmutebutton.Parent = unibarcontainer
            clonedicon = geticonlabel(clonedmutebutton)
            originalicon = geticonlabel(micmutebutton)
            setmutestate(true)
            local hit = clonedmutebutton:WaitForChild("IconHitArea_toggle_mic_mute", 15)
            hit.Activated:Connect(function()
                ismuted = not ismuted
                setmutestate(ismuted)
                if ismuted then
                    if clonedicon then clonedicon.Image = mutedimage end
                else
                    if clonedicon and originalicon then clonedicon.Image = originalicon.Image end
                end
            end)
        end)
    end

    local reconnected = false
    local deadline = tick() + 20
    local conn
    pcall(function()
        if voicechatinternal and voicechatinternal.StateChanged then
            conn = voicechatinternal.StateChanged:Connect(function(_, new)
                local n = string.lower(tostring(new and (new.Name or new) or ""))
                if n:find("join", 1, true) or n:find("connect", 1, true)
                    or n:find("ingame", 1, true) or n:find("active", 1, true)
                    or n:find("joined", 1, true) then
                    reconnected = true
                end
            end)
        end
    end)
    while tick() < deadline and not reconnected do
        pcall(function()
            local st = voicechatinternal and voicechatinternal.VoiceChatState
            if st then
                local n = string.lower(tostring(st.Name or st))
                if n:find("join", 1, true) or n:find("connect", 1, true)
                    or n:find("ingame", 1, true) or n:find("joined", 1, true) then
                    reconnected = true
                end
            end
        end)
        if not reconnected then
            pcall(function()
                local adi = LP:FindFirstChildWhichIsA("AudioDeviceInput", true)
                if adi and adi.Active ~= nil then
                    reconnected = true
                end
            end)
        end
        if joinDone and joinOk and tick() > (joinWait + 1.25) then
            reconnected = true
        end
        task.wait(0.2)
    end
    pcall(function() if conn then conn:Disconnect() end end)

    if forceUnmuteAtEnd then
        local function forceUnmute()
            pcall(function()
                setmutestate(false)
            end)
            ismuted = false
            pcall(function()
                local adi = LocalPlayer:FindFirstChildWhichIsA("AudioDeviceInput", true)
                if adi then
                    adi.Muted = false
                    adi.Active = true
                end
            end)
            pcall(function()
                if voicechatinternal and typeof(voicechatinternal.PublishPause) == "function" then
                    voicechatinternal:PublishPause(false)
                end
            end)
        end
        forceUnmute()
        task.defer(forceUnmute)
        task.delay(0.5, forceUnmute)
    end

    return true, reconnected and "ok" or "ok_quiet"
end

local function cmd_avcb()
    if AvcbRunning then
        if isAlt then Say("avcb already running") end
        return
    end
    if AvcbActive then
        if isAlt then Say("avcb already active") end
        return
    end
    if not getconnectionsfunc then
        if isAlt then Say("avcb unsupported executor") end
        print("[Schweins Alt Control] AVCB needs getconnections (Xeno unsupported)")
        return
    end
    AvcbRunning = true
    if isAlt then
        local muted = isMicMuted()
        if muted == true then
            Say("unmute then waiting...")
        else
            Say("avcb starting...")
        end
    end
    task.spawn(function()
        local ok, reason = pcall(function()
            local success, r = runAVCB({ forceUnmuteAtEnd = false })
            if not success then error(tostring(r or "fail")) end
        end)
        AvcbRunning = false
        if ok then
            AvcbActive = true
            if isAlt then Say("avcb active use .mute .unmute only") end
            print("[Schweins Alt Control] AVCB active")
        else
            if isAlt then Say("avcb failed: " .. tostring(reason):sub(1, 40)) end
            print("[Schweins Alt Control] AVCB failed:", reason)
        end
    end)
end

