local function KahootOnChat(player, message)
    if not KahootActive then return end
    task.spawn(function()

        if message == "SCHWEIN_KCLEAR" or message == ".kclear" or message == "Scores have been cleared!" then
            KahootResetStats()
            return
        end
        if message:find("Welcome to Schweins Kahoot") then
            KahootResetStats()
        end
        if message:find("Question %d+:") then
            for _, q in pairs(KahootQuestions) do
                if message:find(q.q, 1, true) then
                    KahootCurrentQ = q
                    break
                end
            end
        end
        if message == ".options" then
            KahootAnswers = {}
            KahootQStart = tick()
            if KahootRole and KahootRole:find("answer") then
                local bIdx = tonumber(KahootRole:match("%d+"))
                if KahootCurrentQ then
                    task.wait(bIdx * 0.4)
                    Say("Option " .. bIdx .. ": " .. KahootCurrentQ.a[bIdx])
                end
            end
        end
        if message == "Introduce yourself bots" then
            local d = {answer1 = 5, answer2 = 10, answer3 = 15, answer4 = 20, scoreboard = 25}
            if d[KahootRole] then
                task.wait(d[KahootRole])
                if KahootRole == "scoreboard" then
                    Say("And I am the Scoreboard!")
                else
                    Say("I am Answer Bot " .. (KahootRole:match("%d+") or "") .. "!")
                end
                Say("/e wave")
                if KahootRole == "scoreboard" then
                    task.wait(5)
                    KahootDancing = true
                    Say("/e dance2")
                end
                if KahootRole == "host" then
                    task.wait(1)
                    KahootDancing = true
                end
            end
        end
        if KahootRole == "scoreboard" then
            if message:find("The correct answer was Option") then
                local correct = tonumber(message:match("Option (%d+)"))
                local winners = {}
                for name, data in pairs(KahootAnswers) do
                    if data.ans == correct then
                        table.insert(winners, {n = name, t = data.time})
                    end
                end
                table.sort(winners, function(a, b) return a.t < b.t end)
                for i, v in ipairs(winners) do
                    KahootScores[v.n] = (KahootScores[v.n] or 0) + math.max(1, 11 - i)
                end
            elseif message == ".score" then
                local s = {}
                for name, score in pairs(KahootScores) do
                    table.insert(s, {n = name, s = score})
                end
                table.sort(s, function(a, b) return a.s > b.s end)
                if #s > 0 then
                    local out = "Top 3: "
                    for i = 1, math.min(3, #s) do
                        out = out .. i .. ": " .. s[i].n .. " (" .. s[i].s .. ") "
                    end
                    Say(out)
                end
            elseif message:find("QUIZ HAS ENDED") then
                KahootCelebrate()
            else
                local ansNum = tonumber(message)
                if ansNum and ansNum >= 1 and ansNum <= 4 and not KahootAnswers[player.DisplayName] then
                    KahootAnswers[player.DisplayName] = {ans = ansNum, time = tick() - KahootQStart}
                end
            end
        end
    end)
end

