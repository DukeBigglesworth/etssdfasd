function cmd_visualizer4(name, spacing)
    local target = ResolveTarget(name)
    if not target then return end
    local root0 = GetRoot(target)
    if not root0 then return end
    local char = LP.Character
    if not char then return end
    StopAll()
    spacing = tonumber(spacing) or 2.4
    local maxH = 12
    local lastFetch = 0
    local smooth = {0, 0, 0, 0, 0, 0, 0, 0}
    local right = root0.CFrame.RightVector
    if right.Magnitude < 0.05 then right = Vector3.new(1, 0, 0) else right = right.Unit end
    local center = root0.Position

    local folder = Instance.new("Folder")
    folder.Name = "SchweinEqline_" .. tostring(LP.UserId)
    pcall(function()
        folder.Parent = workspace.CurrentCamera or workspace
    end)
    if not folder.Parent then
        folder.Parent = workspace
    end
    EqlineFolder = folder

    local orderNames = {
        "Head", "Torso", "UpperTorso", "LowerTorso",
        "Left Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "Right Arm", "RightUpperArm", "RightLowerArm", "RightHand",
        "Left Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot",
    }
    local orderRank = {}
    for i, n in ipairs(orderNames) do
        orderRank[n] = i
    end

    local bars = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and orderRank[d.Name] then
            local cl = nil
            pcall(function()
                cl = d:Clone()
                for _, ch in ipairs(cl:GetDescendants()) do
                    if ch:IsA("Weld") or ch:IsA("Motor6D") or ch:IsA("WeldConstraint") or ch:IsA("JointInstance") then
                        ch:Destroy()
                    end
                end
                cl.Anchored = true
                cl.CanCollide = false
                cl.CanQuery = false
                cl.CanTouch = false
                cl.Massless = true
                cl.Transparency = math.min(d.Transparency, 0.15)
                cl.Parent = folder
            end)
            if cl and cl.Parent then
                bars[#bars + 1] = { part = cl, rank = orderRank[d.Name] }
                EqlineHidden[d] = {
                    ltm = d.LocalTransparencyModifier,
                    trans = d.Transparency,
                }
                pcall(function()
                    d.LocalTransparencyModifier = 1
                end)
            end
        end
    end

    if #bars == 0 then
        for i = 1, 8 do
            local p = Instance.new("Part")
            p.Name = "EqBar" .. i
            p.Size = Vector3.new(1.2, 2, 1.2)
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.Material = Enum.Material.Neon
            p.Color = Color3.fromHSV((i - 1) / 8, 0.85, 1)
            p.Parent = folder
            bars[#bars + 1] = { part = p, rank = i }
        end
    end

    table.sort(bars, function(a, b)
        return a.rank < b.rank
    end)

    pcall(function()
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.PlatformStand = true
            hum.WalkSpeed = 0
            hum.AutoRotate = false
        end
    end)

    ActiveLoops.visualizer4 = RunService.RenderStepped:Connect(function()
        local root = GetRoot(target)
        if root then
            center = root.Position
            right = root.CFrame.RightVector
            if right.Magnitude < 0.05 then
                right = Vector3.new(1, 0, 0)
            else
                right = right.Unit
            end
        end
        if tick() - lastFetch > 0.08 then
            lastFetch = tick()
            local data = getEq and getEq() or nil
            if data and type(data.bands) == "table" then
                for i = 1, 8 do
                    smooth[i] = smooth[i] * 0.5 + (tonumber(data.bands[i]) or 0) * 0.5
                end
            elseif data then
                smooth[1] = smooth[1] * 0.5 + (tonumber(data.bass) or 0) * 0.5
                smooth[2] = smooth[1]
                smooth[4] = smooth[4] * 0.5 + (tonumber(data.mid) or 0) * 0.5
                smooth[5] = smooth[4]
                smooth[7] = smooth[7] * 0.5 + (tonumber(data.treble) or 0) * 0.5
                smooth[8] = smooth[7]
            end
        end
        local n = #bars
        for i = 1, n do
            local entry = bars[i]
            local part = entry and entry.part
            if part and part.Parent then
                local tt = (n == 1) and 0 or ((i - 1) / (n - 1))
                local bandIdx = math.clamp(math.floor(tt * 7 + 1 + 0.5), 1, 8)
                local level = math.clamp(smooth[bandIdx] or 0, 0, 1)
                local height = 1 + level * maxH
                local centered = i - (n + 1) / 2
                local pos = center + right * (centered * spacing) + Vector3.new(0, height, 0)
                part.Anchored = true
                part.CFrame = CFrame.new(pos)
            end
        end
    end)
end


