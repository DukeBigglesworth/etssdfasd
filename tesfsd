local function cmd_flingall()
    StopAll()
    SetNoclip(true)
    local myRoot = GetRoot(LP)
    if not myRoot then return end
    local target = nil
    local stickUntil = 0

    local function pickTarget()
        local others = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and not S.altAccounts[plr.Name] and plr.Name ~= S.mainAccount and GetRoot(plr) then
                table.insert(others, plr)
            end
        end
        if #others == 0 then return nil end
        return others[math.random(1, #others)]
    end

    target = pickTarget()
    stickUntil = tick() + 2.5

    local boost = RunService.Heartbeat:Connect(function()
        myRoot = GetRoot(LP)
        if not myRoot then return end
        if not target or not target.Parent or not GetRoot(target) or tick() > stickUntil then
            target = pickTarget()
            stickUntil = tick() + 2.5
        end
        local tr = target and GetRoot(target)
        if tr then
            myRoot.CFrame = tr.CFrame * CFrame.new(0, 0, 1)
            myRoot.AssemblyLinearVelocity = Vector3.new(math.random(-200, 200), math.random(90, 220), math.random(-200, 200))
            myRoot.AssemblyAngularVelocity = Vector3.new(50, 50, 50)
        end
    end)
    ActiveLoops["flingall"] = boost
end

