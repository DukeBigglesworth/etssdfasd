    if not p then return end
    StopAll()
    local conn = RunService.Heartbeat:Connect(function()
        local root = GetRoot(p)
        local myRoot = GetRoot(LP)
        if not root or not myRoot then return end
        local dist = (root.Position - myRoot.Position).Magnitude
        if dist > 25 then
            local ang = math.random() * math.pi * 2
            local distBehind = math.random(4, 9)
            local offset = Vector3.new(math.cos(ang) * 2, 0, math.sin(ang) * 2)
            local pos = root.Position - root.CFrame.LookVector * distBehind + offset
            TeleportOnce(CFrame.lookAt(pos, root.Position))
        else
            myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(root.Position.X, myRoot.Position.Y, root.Position.Z))
        end
    end)
    ActiveLoops["stalk"] = conn
end

