local function isPlayerInRange(player)
    local bot = Players:FindFirstChild(S.queueBot) or Players:FindFirstChild(S.mainAccount) or currentHost
    if not bot or not bot.Character then return false end
    local hr = bot.Character:FindFirstChild("HumanoidRootPart")
    if not hr then return false end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return false end
    return (hr.Position - player.Character.HumanoidRootPart.Position).Magnitude <= (S.PROXIMITY_RANGE or 10)
end

local function setupPlayers()
    if not currentHost or not currentHost.Character then return end
    local hostRoot = currentHost.Character:FindFirstChild("HumanoidRootPart")
    if not hostRoot then return end
    local participants = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= currentHost and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(participants, p)
        end
    end
    if #participants == 0 then
        if isQueueBot then Say("no players to setup") end
        return
    end
    local hostCF = hostRoot.CFrame
    local forward = hostCF.LookVector
    local center = hostCF.Position + forward * (S.SETUP_DISTANCE or 8)
    local radius = (S.SETUP_DISTANCE or 8) * 0.8
    local spread = math.pi * 0.75
    local step = spread / math.max(#participants - 1, 1)
    local start = -spread / 2
    for i, p in ipairs(participants) do
        local ang = start + step * (i - 1)
        local ox = math.sin(ang) * radius
        local oz = math.cos(ang) * radius
        local pos = center + hostCF.RightVector * ox + forward * oz
        local look = CFrame.lookAt(pos, center)
        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            p.Character.HumanoidRootPart.CFrame = look
        end
    end
    if isQueueBot then
        Say("setup complete " .. #participants)
    end
    isSetupActive = true
    startMusicLoops()
end

