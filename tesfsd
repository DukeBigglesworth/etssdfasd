        exp.Parent = workspace
    end)
end

local function cmd_elevator(name)
    local p = ResolveTarget(name)
    if not p then return end
    if not GetRoot(p) then return end
    StopAll()
    SetNoclip(true)
    local idx, total = GetAltIndex()
    total = math.max(total, 1)
    local cols = math.ceil(math.sqrt(total))
    local row = math.floor((idx - 1) / cols)
    local col = (idx - 1) % cols
    local spacing = 3.2
    local ox = (col - (cols - 1) / 2) * spacing
    local oz = (row - (cols - 1) / 2) * spacing
    local lay = CFrame.Angles(math.rad(-90), 0, 0)
    local lift = 0
    pcall(function()
        local hum = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.AutoRotate = false
            hum.PlatformStand = true
        end
    end)

    ActiveLoops.elevator = RunService.Heartbeat:Connect(function()
        local targetRoot = GetRoot(p)
        local myRoot = GetRoot(LP)
        if not targetRoot or not myRoot then return end
        lift = math.min(lift + 0.06, 35)
        local pos = targetRoot.Position + Vector3.new(ox, -2.8 + lift, oz)
        applyRootCF(myRoot, CFrame.new(pos) * lay, targetRoot)
    end)
end

local function cmd_mine(name)
    local p = ResolveTarget(name)
    if not p then return end
    local anchor = GetRoot(p)
    if not anchor then return end
    StopAll()
    SetNoclip(true)
    MineMode = true
    local char = LP.Character
    local head = char and char:FindFirstChild("Head")
    if not GetRoot(LP) then return end
    local ang = math.random() * math.pi * 2
    local dist = math.random() * 20
    local fixedX = anchor.Position.X + math.cos(ang) * dist
    local fixedZ = anchor.Position.Z + math.sin(ang) * dist
    local feetY = anchor.Position.Y - 3
    pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}
        if LP.Character then table.insert(filter, LP.Character) end
        if p.Character then table.insert(filter, p.Character) end
        params.FilterDescendantsInstances = filter
        local hit = workspace:Raycast(anchor.Position + Vector3.new(0, 2, 0), Vector3.new(0, -15, 0), params)
        if hit then
            feetY = hit.Position.Y
        else
            local hum = p.Character and p.Character:FindFirstChildWhichIsA("Humanoid")
            if hum then
                feetY = anchor.Position.Y - (hum.HipHeight + 1)
            end
        end
    end)
    local headOffset = 1.5
    pcall(function()
        local h = LP.Character and LP.Character:FindFirstChild("Head")
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if h and hrp then
            headOffset = h.Position.Y - hrp.Position.Y
        end
    end)
    local fixedPos = Vector3.new(fixedX, feetY - headOffset, fixedZ)
    TeleportOnce(CFrame.new(fixedPos))
    if head then
        local touchConn
        touchConn = head.Touched:Connect(function(hit)
            if not MineMode then return end
            local other = Players:GetPlayerFromCharacter(hit.Parent)
            if other and other ~= LP and not S.altAccounts[other.Name] and other.Name ~= S.mainAccount then
                MineMode = false
                if touchConn then touchConn:Disconnect() end
                ActiveLoops["mine"] = nil
                pcall(function()
                    if LP.Character then LP.Character:BreakJoints() end
                end)
                local exp = Instance.new("Explosion")
                exp.Position = head.Position
                exp.BlastRadius = 14
                exp.BlastPressure = 0
                exp.Parent = workspace
            end
        end)
        ActiveLoops["mine"] = touchConn
    end
end

