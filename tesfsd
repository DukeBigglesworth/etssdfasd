function cmd_visualizer3()
    StopAll()
    SetNoclip(true)
    local lastFetch = 0
    local smooth = {0, 0, 0, 0, 0, 0, 0, 0}
    local bass, mid, treble = 0, 0, 0
    pcall(function()
