local function cmd_sync(query)
    if not query or tostring(query):gsub("%s+", "") == "" then
        if isAlt then Say("usage: .sync name") end
        return
    end
    local p = FindPlayer(query)
    if not p then
        if isAlt then Say("player not found") end
        return
    end
    local uid = p.UserId
    local ok = false
    pcall(function()
        local pg = LP:FindFirstChild("PlayerGui") or LP:WaitForChild("PlayerGui", 5)
        if not pg then return end
        local menu = pg:FindFirstChild("MenuGUI", true) or pg:WaitForChild("MenuGUI", 5)
        if not menu then return end
        local emote = menu:FindFirstChild("EmoteMenu", true) or menu:WaitForChild("EmoteMenu", 5)
        if not emote then return end
        local remote = emote:FindFirstChild("UnifiedSyncRequest", true)
        if not remote then return end
        if remote:IsA("BindableEvent") then
            remote:Fire(uid)
            ok = true
        elseif remote:IsA("RemoteEvent") then
            remote:FireServer(uid)
            ok = true
        else
            pcall(function()
                remote:Fire(uid)
                ok = true
            end)
            if not ok then
                pcall(function()
                    remote:FireServer(uid)
                    ok = true
                end)
            end
        end
    end)
    if isAlt and not ok then
        Say("sync failed (menu missing?)")
    end
end


local function cmd_corbit(name, rad)
    local p = ResolveTarget(name)
    if not p then return end
    local root = GetRoot(p)
    if not root then return end
    StopAll()
    StartDance2()
    if tonumber(rad) then
        MoveSettings.OrbitRadius = tonumber(rad)
    end

    local center = root.Position
    local spin = 0
    local lastT = tick()
    local r = MoveSettings.OrbitRadius
    ActiveLoops.corbit = RunService.Heartbeat:Connect(function()
        local idx, total = GetAltIndex()
        total = math.max(total, 1)
        local myRoot = GetRoot(LP)
        if not myRoot then return end
        local now = tick()
        local dt = math.clamp(now - lastT, 0, 0.05)
        lastT = now
        spin = (spin + MoveSettings.OrbitSpeed * dt) % (math.pi * 2)
        local base = ((idx - 1) / total) * math.pi * 2
        local angle = base + spin
        local pos = Vector3.new(
            center.X + math.cos(angle) * r,
            center.Y + MoveSettings.Height,
            center.Z + math.sin(angle) * r
        )
        applyRootCF(myRoot, CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z)), myRoot)
    end)
end

local function cmd_triangle(name, rad)
