        if flat.Magnitude < 0.05 then
            flat = Vector3.new(0, 0, 1)
        else
            flat = flat.Unit
        end
        local goal = targetRoot.Position - flat * spacing
        local dist = (myRoot.Position - goal).Magnitude


        if dist > 40 then
            myRoot.CFrame = CFrame.new(goal + Vector3.new(0, 3, 0))
