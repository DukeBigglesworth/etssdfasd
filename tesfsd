        if hum then
            hum.AutoRotate = false
            hum.PlatformStand = true
            hum.WalkSpeed = 0
        end
    end)
    local function motor(char, names)
        for i = 1, #names do
            local m = char:FindFirstChild(names[i], true)
            if m and m:IsA("Motor6D") then return m end
        end
        return nil
    end
    ActiveLoops.visualizer3 = RunService.RenderStepped:Connect(function()
        local char = LP.Character
        if not char then return end
        if tick() - lastFetch > 0.1 then
            lastFetch = tick()
            local data = getEq()
            if data then
                if type(data.bands) == "table" then
                    for i = 1, 8 do
                        smooth[i] = smooth[i] * 0.6 + (tonumber(data.bands[i]) or 0) * 0.4
                    end
                end
                bass = bass * 0.6 + (tonumber(data.bass) or 0) * 0.4
                mid = mid * 0.6 + (tonumber(data.mid) or 0) * 0.4
                treble = treble * 0.6 + (tonumber(data.treble) or 0) * 0.4
            end
        end
        local b, m, tr = math.clamp(bass, 0, 1), math.clamp(mid, 0, 1), math.clamp(treble, 0, 1)
        local tnow = tick()
        local neck = motor(char, {"Neck"})
        local lsh = motor(char, {"Left Shoulder", "LeftShoulder"})
        local rsh = motor(char, {"Right Shoulder", "RightShoulder"})
        local lhp = motor(char, {"Left Hip", "LeftHip"})
        local rhp = motor(char, {"Right Hip", "RightHip"})
        local rootj = motor(char, {"RootJoint", "Waist"})
        for _, mot in ipairs({neck, lsh, rsh, lhp, rhp, rootj}) do
            if mot then LimbFX.save(mot) end
        end
        if neck then neck.Transform = CFrame.Angles(math.rad(-25) * tr, math.sin(tnow * 9) * math.rad(18) * tr, 0) end
        if rootj then rootj.Transform = CFrame.Angles(math.sin(tnow * 5) * math.rad(12) * m, math.sin(tnow * 3) * math.rad(20) * m, 0) end
        if lsh then lsh.Transform = CFrame.Angles(math.rad(-160) * m + math.sin(tnow * 10) * math.rad(40) * m, 0, math.rad(-70) * m) end
        if rsh then rsh.Transform = CFrame.Angles(math.rad(-160) * m + math.cos(tnow * 10) * math.rad(40) * m, 0, math.rad(70) * m) end
        if lhp then lhp.Transform = CFrame.Angles(math.rad(-70) * b + math.sin(tnow * 8) * math.rad(35) * b, 0, 0) end
